COSMOS_ENDPOINT=https://YOUR-COSMOS-ACCOUNT.documents.azure.com:443/
COSMOS_DATABASE=recipes
COSMOS_CONTAINER=conversations
AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-ACCOUNT.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_API_VERSION=2024-10-21
# Local Azure CLI credentials need OpenAI User and Cosmos data contributor roles.
# Leave AZURE_CLIENT_ID unset locally; the deployment sets the managed identity.
APPLICATIONINSIGHTS_CONNECTION_STRING=
CAPTURE_MESSAGE_CONTENT=true
# False is for HTTP localhost only. Azure uses true.
COOKIE_SECURE=false
MAX_INPUT_CHARS=4000
MAX_CONTEXT_TURNS=10
MAX_OUTPUT_TOKENS=1800
TURN_TIMEOUT_SECONDS=180
REQUESTS_PER_MINUTE=6
